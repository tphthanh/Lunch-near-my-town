import React, { useState, useEffect } from 'react';
import { 
  Utensils, 
  Coffee, 
  Sparkles, 
  CheckCircle2, 
  ShieldCheck, 
  Zap, 
  Banknote, 
  Info, 
  Flame, 
  RotateCcw,
  ExternalLink,
  ChevronRight
} from 'lucide-react';
import confetti from 'canvas-confetti';

// 9 Món ăn thực tế kèm giá & thuộc tính dinh dưỡng
const FOOD_MENU = [
  { id: 'f1', name: 'Cơm bụi / Cơm rang', price: 50000, category: 'Cơm', profile: 'HEAVY_FAT', calories: '~680 kcal', tag: 'Chắc bụng, nhiều dầu mỡ' },
  { id: 'f2', name: 'Phở bò / Phở gà', price: 50000, category: 'Bún/Phở', profile: 'RED_MEAT', calories: '~520 kcal', tag: 'Nóng hổi, giàu đạm & sắt' },
  { id: 'f3', name: 'Ngan chặt / Ngan nướng', price: 150000, category: 'Đặc sản', profile: 'HIGH_PROTEIN_FAT', calories: '~750 kcal', tag: 'Đậm đà, đạm cao, no lâu' },
  { id: 'f4', name: 'Bún đậu / Bún giả cầy', price: 60000, category: 'Món nước/chấm', profile: 'HIGH_SODIUM_FAT', calories: '~620 kcal', tag: 'Đậm vị, nhiều gia vị mắm' },
  { id: 'f5', name: 'Bún riêu / Bún ngan', price: 50000, category: 'Bún/Phở', profile: 'SAVORY_ACID', calories: '~490 kcal', tag: 'Nước dùng thanh ngọt dễ ăn' },
  { id: 'f6', name: 'Bún chả Hà Nội', price: 50000, category: 'Món nướng', profile: 'SAVORY_GRILLED', calories: '~530 kcal', tag: 'Thịt nướng than hoa thơm lừng' },
  { id: 'f7', name: 'Bún cá chấm', price: 50000, category: 'Đồ chiên', profile: 'FRIED_CRUNCH', calories: '~560 kcal', tag: 'Cá chiên giòn rụm kèm mắm tỏi' },
  { id: 'f8', name: 'Xôi chả trứng', price: 50000, category: 'Xôi', profile: 'HEAVY_CARB', calories: '~600 kcal', tag: 'Nếp dẻo, nhiều tinh bột' },
  { id: 'f9', name: 'Mỳ gà tần', price: 50000, category: 'Mì/Thuốc bắc', profile: 'HERBAL_NOURISH', calories: '~510 kcal', tag: 'Bổ dưỡng, thảo mộc ngải cứu' },
];

// 9 Món đồ uống thực tế kèm giá & công năng
const DRINK_MENU = [
  { id: 'd1', name: 'Trà đá / Chè tươi hãm', price: 5000, benefit: 'COOLING_DETOX', goodFor: ['HEAVY_FAT', 'HIGH_SODIUM_FAT', 'SAVORY_GRILLED'], note: 'Giải mặn, sạch miệng, hạ nhiệt tức thì' },
  { id: 'd2', name: 'Nước mía tắc / quất', price: 15000, benefit: 'DIGESTIVE_ACID', goodFor: ['FRIED_CRUNCH', 'SAVORY_GRILLED', 'HIGH_PROTEIN_FAT'], note: 'Chua thanh trợ tiêu hóa đồ chiên/nướng' },
  { id: 'd3', name: 'Trà tắc xí muội', price: 20000, benefit: 'DIGESTIVE_ACID', goodFor: ['HEAVY_FAT', 'HEAVY_CARB'], note: 'Cắt cơn ngấy dầu mỡ và nếp dẻo' },
  { id: 'd4', name: 'Nước ép ổi hồng / Cóc ép', price: 30000, benefit: 'VITAMIN_C', goodFor: ['RED_MEAT'], note: 'Giàu Vitamin C giúp hấp thu tối đa chất sắt' },
  { id: 'd5', name: 'Nước dừa xiêm tươi', price: 35000, benefit: 'ELECTROLYTE', goodFor: ['HIGH_SODIUM_FAT', 'HIGH_PROTEIN_FAT'], note: 'Bù nước, cân bằng lượng muối từ mắm' },
  { id: 'd6', name: 'Trà sen vàng / Trà lài', price: 30000, benefit: 'COOLING_DETOX', goodFor: ['SAVORY_ACID', 'HERBAL_NOURISH'], note: 'Thanh tao, êm dịu dạ dày' },
  { id: 'd7', name: 'Cà phê nâu đá / Bạc xỉu', price: 25000, benefit: 'ENERGY_BOOST', goodFor: ['SAVORY_ACID'], note: 'Nạp năng lượng, tỉnh táo buổi chiều' },
  { id: 'd8', name: 'Sữa hạt đậu nành / Đậu xanh', price: 15000, benefit: 'NOURISH_SMOOTH', goodFor: ['HEAVY_CARB', 'FRIED_CRUNCH'], note: 'Làm dịu hệ tiêu hóa sau món khô/cay' },
  { id: 'd9', name: 'Trà chanh giã tay ít đường', price: 25000, benefit: 'REFRESH_LIGHT', goodFor: ['HEAVY_FAT', 'HIGH_PROTEIN_FAT'], note: 'Tinh dầu chanh tươi sảng khoái, nhẹ bụng' },
];

export default function LunchSuggesterApp() {
  const [selectedFood, setSelectedFood] = useState(FOOD_MENU[0]);
  const [selectedDrink, setSelectedDrink] = useState(DRINK_MENU[2]);
  const [mode, setMode] = useState('nutrition'); // 'nutrition' | 'wild'
  const [isLocked, setIsLocked] = useState(false);

  // Khi chọn món ăn, tự động tính toán đồ uống phù hợp nhất
  const handleSelectFood = (food) => {
    setSelectedFood(food);
    setIsLocked(false);

    if (mode === 'nutrition') {
      // Tìm đồ uống tối ưu dinh dưỡng
      const matched = DRINK_MENU.filter(d => d.goodFor && d.goodFor.includes(food.profile));
      if (matched.length > 0) {
        setSelectedDrink(matched[0]);
      } else {
        setSelectedDrink(DRINK_MENU[0]);
      }
    }
  };

  // Đổi đồ uống ngẫu nhiên dựa theo chế độ
  const handleRandomizeDrink = () => {
    setIsLocked(false);
    if (mode === 'nutrition') {
      const matched = DRINK_MENU.filter(d => d.goodFor && d.goodFor.includes(selectedFood.profile));
      const pool = matched.length > 0 ? matched : DRINK_MENU;
      const filtered = pool.filter(d => d.id !== selectedDrink.id);
      const random = filtered[Math.floor(Math.random() * filtered.length)] || pool[0];
      setSelectedDrink(random);
    } else {
      const filtered = DRINK_MENU.filter(d => d.id !== selectedDrink.id);
      const random = filtered[Math.floor(Math.random() * filtered.length)];
      setSelectedDrink(random);
    }
  };

  // Xác định đồ uống có chuẩn dinh dưỡng với món đang chọn hay không
  const isOptimalMatch = selectedDrink.goodFor && selectedDrink.goodFor.includes(selectedFood.profile);

  // Lời giải thích khoa học
  const getInsightText = () => {
    if (mode === 'wild') {
      return 'Sự kết hợp ngẫu hứng, phá cách không ràng buộc để thử nghiệm khẩu vị mới lạ!';
    }
    if (selectedFood.profile === 'RED_MEAT' && selectedDrink.benefit === 'VITAMIN_C') {
      return `Lượng Vitamin C dồi dào trong ${selectedDrink.name} giúp tăng khả năng hấp thụ sắt heme từ ${selectedFood.name}.`;
    }
    if ((selectedFood.profile === 'HEAVY_FAT' || selectedFood.profile === 'FRIED_CRUNCH' || selectedFood.profile === 'HEAVY_CARB') && selectedDrink.benefit === 'DIGESTIVE_ACID') {
      return `Vị chua thanh tự nhiên trong ${selectedDrink.name} kích thích men tiêu hóa, giảm đáng kể cảm giác ngấy và nặng bụng sau khi ăn.`;
    }
    if (selectedFood.profile === 'HIGH_SODIUM_FAT' && (selectedDrink.benefit === 'COOLING_DETOX' || selectedDrink.benefit === 'ELECTROLYTE')) {
      return `Độ thanh mát và khoáng chất trong ${selectedDrink.name} giúp trung hòa vị mặn đậm của mắm, hạn chế tình trạng háo nước.`;
    }
    return `Combo cân đối: ${selectedFood.name} chắc bụng kết hợp cùng ${selectedDrink.name} tươi mát giúp thanh lọc cơ thể.`;
  };

  // Chốt món và bắn pháo hoa
  const handleConfirmCombo = () => {
    setIsLocked(true);
    confetti({
      particleCount: 80,
      spread: 70,
      origin: { y: 0.6 }
    });
  };

  const formatMoney = (val) => new Intl.NumberFormat('vi-VN').format(val) + ' đ';

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans p-4 md:p-8">
      <div className="max-w-5xl mx-auto space-y-6">
        
        {/* Tiêu đề */}
        <header className="bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div className="flex items-center gap-3.5">
            <div className="w-12 h-12 bg-gradient-to-tr from-orange-500 to-amber-500 rounded-2xl flex items-center justify-center text-white shadow-md shadow-orange-500/20">
              <Utensils className="w-6 h-6" />
            </div>
            <div>
              <h1 className="text-xl md:text-2xl font-black text-slate-900 tracking-tight">Hôm Nay Ăn Gì?</h1>
              <p className="text-xs md:text-sm text-slate-500 font-medium">Chọn món chính — Tự động gợi ý thức uống chuẩn dinh dưỡng</p>
            </div>
          </div>

          {/* Công tắc chế độ */}
          <div className="grid grid-cols-2 gap-2 bg-slate-100 p-1.5 rounded-2xl w-full sm:w-auto">
            <button
              onClick={() => { setMode('nutrition'); handleSelectFood(selectedFood); }}
              className={`py-2 px-3 rounded-xl text-xs font-black flex items-center justify-center gap-1.5 transition-all ${
                mode === 'nutrition'
                  ? 'bg-emerald-600 text-white shadow-sm'
                  : 'text-slate-600 hover:text-slate-900'
              }`}
            >
              <ShieldCheck className="w-3.5 h-3.5" />
              Chuẩn Dinh Dưỡng
            </button>
            <button
              onClick={() => setMode('wild')}
              className={`py-2 px-3 rounded-xl text-xs font-black flex items-center justify-center gap-1.5 transition-all ${
                mode === 'wild'
                  ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white shadow-sm'
                  : 'text-slate-600 hover:text-slate-900'
              }`}
            >
              <Zap className="w-3.5 h-3.5" />
              Tự Chọn Phá Cách 🎲
            </button>
          </div>
        </header>

        {/* Nội dung chính 2 cột */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* Cột Trái: Chọn Món Ăn (Chiếm 2 cột) */}
          <div className="lg:col-span-2 space-y-4">
            <div className="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-black text-slate-900 flex items-center gap-2">
                  <span className="w-6 h-6 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center text-xs font-black">1</span>
                  Bước 1: Chọn món ăn trưa của bạn
                </h2>
                <span className="text-xs font-semibold text-slate-400">9 lựa chọn</span>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                {FOOD_MENU.map((item) => {
                  const isSelected = selectedFood.id === item.id;
                  return (
                    <button
                      key={item.id}
                      onClick={() => handleSelectFood(item)}
                      className={`text-left p-3.5 rounded-2xl border-2 transition-all relative flex flex-col justify-between ${
                        isSelected 
                          ? 'border-orange-500 bg-orange-50/40 shadow-sm' 
                          : 'border-slate-100 bg-slate-50/50 hover:border-slate-300'
                      }`}
                    >
                      <div>
                        <div className="flex items-center justify-between mb-1">
                          <span className="text-[10px] font-black uppercase text-slate-400 bg-slate-200/60 px-1.5 py-0.5 rounded">
                            {item.category}
                          </span>
                          <span className="text-xs font-black text-orange-600">
                            {formatMoney(item.price)}
                          </span>
                        </div>
                        <h3 className="font-black text-slate-800 text-sm leading-snug">{item.name}</h3>
                        <p className="text-[11px] text-slate-500 mt-1 line-clamp-1">{item.tag}</p>
                      </div>

                      <div className="mt-2.5 pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-400 font-medium">
                        <span className="flex items-center gap-1">
                          <Flame className="w-3 h-3 text-red-500" />
                          {item.calories}
                        </span>
                        {isSelected && (
                          <span className="text-orange-600 font-bold flex items-center gap-0.5">
                            Đã chọn <CheckCircle2 className="w-3 h-3" />
                          </span>
                        )}
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Bước 2: Danh sách Đồ Uống Gợi Ý */}
            <div className="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200/80">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-base font-black text-slate-900 flex items-center gap-2">
                  <span className="w-6 h-6 bg-cyan-100 text-cyan-700 rounded-full flex items-center justify-center text-xs font-black">2</span>
                  Bước 2: Gợi ý đồ uống đi kèm
                </h2>
                <button
                  onClick={handleRandomizeDrink}
                  className="text-xs font-bold text-cyan-700 hover:text-cyan-800 flex items-center gap-1 bg-cyan-50 px-2.5 py-1.5 rounded-xl transition-all"
                >
                  <RotateCcw className="w-3.5 h-3.5" />
                  Gợi ý món khác
                </button>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {DRINK_MENU.map((drink) => {
                  const isSelected = selectedDrink.id === drink.id;
                  const isBestMatch = drink.goodFor && drink.goodFor.includes(selectedFood.profile);

                  return (
                    <button
                      key={drink.id}
                      onClick={() => { setSelectedDrink(drink); setIsLocked(false); }}
                      className={`text-left p-3.5 rounded-2xl border-2 transition-all relative flex flex-col justify-between ${
                        isSelected 
                          ? 'border-cyan-600 bg-cyan-50/40 shadow-sm' 
                          : isBestMatch && mode === 'nutrition'
                          ? 'border-emerald-300 bg-emerald-50/20 hover:border-emerald-400'
                          : 'border-slate-100 bg-slate-50/50 hover:border-slate-300'
                      }`}
                    >
                      <div>
                        {isBestMatch && mode === 'nutrition' && (
                          <span className="inline-block text-[9px] font-black uppercase text-emerald-800 bg-emerald-100 px-1.5 py-0.5 rounded mb-1">
                            ⭐ Cặp đôi tối ưu
                          </span>
                        )}
                        <h3 className="font-black text-slate-800 text-xs leading-snug">{drink.name}</h3>
                        <p className="text-[11px] text-slate-500 mt-1 line-clamp-2">{drink.note}</p>
                      </div>

                      <div className="mt-2 pt-2 border-t border-slate-200/60 flex items-center justify-between text-xs">
                        <span className="font-extrabold text-cyan-700">{formatMoney(drink.price)}</span>
                        {isSelected && <CheckCircle2 className="w-3.5 h-3.5 text-cyan-600" />}
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          {/* Cột Phải: Hóa đơn & Phân tích dinh dưỡng */}
          <div className="space-y-4">
            <div className={`bg-white rounded-3xl p-6 shadow-xl border-2 transition-all sticky top-6 ${
              isOptimalMatch && mode === 'nutrition'
                ? 'border-emerald-500'
                : mode === 'wild'
                ? 'border-purple-500'
                : 'border-slate-200'
            }`}>
              
              {/* Badge Trạng thái */}
              <div className="text-center mb-5">
                {mode === 'nutrition' ? (
                  isOptimalMatch ? (
                    <span className="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-800 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
                      <ShieldCheck className="w-4 h-4 text-emerald-600" />
                      Cặp Đôi Chuẩn Dinh Dưỡng
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1.5 bg-amber-100 text-amber-800 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
                      <Sparkles className="w-4 h-4 text-amber-600" />
                      Combo Đổi Vị Thư Giãn
                    </span>
                  )
                ) : (
                  <span className="inline-flex items-center gap-1.5 bg-purple-100 text-purple-900 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
                    <Zap className="w-4 h-4 text-purple-600" />
                    Tự Chọn Phá Cách 🎲
                  </span>
                )}
              </div>

              {/* Chi tiết 2 món đã chọn */}
              <div className="space-y-3 mb-6">
                <div className="p-3 bg-slate-50 rounded-2xl flex items-center justify-between border border-slate-200">
                  <div>
                    <span className="text-[10px] font-black uppercase text-orange-600 bg-orange-100 px-2 py-0.5 rounded">Món chính</span>
                    <h4 className="font-black text-slate-800 text-sm mt-1">{selectedFood.name}</h4>
                  </div>
                  <span className="font-extrabold text-sm text-slate-700">{formatMoney(selectedFood.price)}</span>
                </div>

                <div className="p-3 bg-slate-50 rounded-2xl flex items-center justify-between border border-slate-200">
                  <div>
                    <span className="text-[10px] font-black uppercase text-cyan-700 bg-cyan-100 px-2 py-0.5 rounded">Đồ uống</span>
                    <h4 className="font-black text-slate-800 text-sm mt-1">{selectedDrink.name}</h4>
                  </div>
                  <span className="font-extrabold text-sm text-slate-700">{formatMoney(selectedDrink.price)}</span>
                </div>
              </div>

              {/* Tổng tiền */}
              <div className="p-4 bg-orange-50/80 rounded-2xl border border-orange-200 mb-5 flex items-center justify-between">
                <span className="font-bold text-slate-600 text-xs flex items-center gap-1.5">
                  <Banknote className="w-4 h-4 text-orange-500" />
                  Tổng thanh toán:
                </span>
                <span className="text-xl font-black text-orange-600">
                  {formatMoney(selectedFood.price + selectedDrink.price)}
                </span>
              </div>

              {/* Giải thích dinh dưỡng */}
              <div className="p-3.5 bg-slate-100 rounded-2xl text-xs text-slate-600 leading-relaxed flex items-start gap-2.5 mb-6 border border-slate-200">
                <Info className="w-4 h-4 text-slate-500 shrink-0 mt-0.5" />
                <span>{getInsightText()}</span>
              </div>

              {/* Nút Chốt Combo */}
              <button
                onClick={handleConfirmCombo}
                className={`w-full py-4 text-white font-black text-sm rounded-2xl shadow-lg transition-all flex items-center justify-center gap-2 active:scale-95 ${
                  isLocked 
                    ? 'bg-emerald-600 shadow-emerald-600/30' 
                    : 'bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 shadow-orange-500/30'
                }`}
              >
                {isLocked ? (
                  <>
                    <CheckCircle2 className="w-5 h-5" />
                    Đã Chốt Combo Bữa Trưa!
                  </>
                ) : (
                  <>
                    <Sparkles className="w-5 h-5" />
                    Chốt Combo Trưa Nay
                  </>
                )}
              </button>

            </div>
          </div>

        </div>

      </div>
    </div>
  );
}
